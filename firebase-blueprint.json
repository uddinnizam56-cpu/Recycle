{
  "entities": {
    "UserPublicProfile": {
      "title": "UserPublicProfile",
      "description": "Non-PII citizen or operator recycling profile stored at /users/{userId}.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "role": {
          "type": "string",
          "enum": ["customer", "executive", "business", "admin"]
        },
        "walletBalance": {
          "type": "number"
        },
        "ecoRewardPoints": {
          "type": "number"
        },
        "totalRecycledKg": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "displayName",
        "role",
        "walletBalance",
        "ecoRewardPoints",
        "totalRecycledKg",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII record for a user at /users/{userId}/private/info.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "phone": {
          "type": "string",
          "minLength": 0,
          "maxLength": 32
        },
        "area": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100
        },
        "city": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "phone", "area", "city", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Verified administrator role document.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "grantedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "grantedAt"]
    },
    "ScrapRateRecord": {
      "title": "ScrapRateRecord",
      "description": "Live recyclable material spot rate record managed by admins.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "rate": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "enum": ["kg", "piece"]
        },
        "co2Offset": {
          "type": "number"
        },
        "minQty": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "updatedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "category",
        "name",
        "rate",
        "unit",
        "co2Offset",
        "minQty",
        "updatedByUid",
        "updatedAt"
      ]
    },
    "PickupOrderRecord": {
      "title": "PickupOrderRecord",
      "description": "Doorstep scrap pickup booking owned by a signed-in user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "orderNumber": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "area": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "city": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "status": {
          "type": "string",
          "enum": [
            "requested",
            "assigned",
            "en_route",
            "arrived",
            "weighing",
            "completed",
            "cancelled"
          ]
        },
        "scheduledDate": {
          "type": "string",
          "minLength": 4,
          "maxLength": 40
        },
        "timeSlot": {
          "type": "string",
          "minLength": 3,
          "maxLength": 60
        },
        "totalEstimatedAmount": {
          "type": "number"
        },
        "finalAmount": {
          "type": "number"
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["UPI", "Cash", "PunarChakra Wallet"]
        },
        "itemsSummary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "co2SavedTotal": {
          "type": "number"
        },
        "rating": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "orderNumber",
        "ownerUid",
        "customerName",
        "area",
        "city",
        "status",
        "scheduledDate",
        "timeSlot",
        "totalEstimatedAmount",
        "finalAmount",
        "paymentMethod",
        "itemsSummary",
        "co2SavedTotal",
        "rating",
        "createdAt",
        "updatedAt"
      ]
    },
    "ActivityLogRecord": {
      "title": "ActivityLogRecord",
      "description": "AI/AR scan, recycling tip, and operational telemetry record.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "actorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "actionType": {
          "type": "string",
          "enum": [
            "PICKUP_SCHEDULED",
            "ORDER_STATUS_UPDATED",
            "AI_PHOTO_SCAN",
            "AR_SPATIAL_SCAN",
            "RECYCLING_TIP_ADDED",
            "WALLET_WITHDRAWAL",
            "VOUCHER_REDEEMED",
            "RATE_UPDATED",
            "FORM_CREATED"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "details": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500
        },
        "materialId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80
        },
        "quantity": {
          "type": "number"
        },
        "estimatedValue": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerUid",
        "actorName",
        "actionType",
        "summary",
        "details",
        "materialId",
        "quantity",
        "estimatedValue",
        "createdAt"
      ]
    },
    "GoogleFormRecord": {
      "title": "GoogleFormRecord",
      "description": "Metadata reference for a Google Form connected or created by PunarChakra.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "responderUri": {
          "type": "string",
          "minLength": 0,
          "maxLength": 400
        },
        "webViewLink": {
          "type": "string",
          "minLength": 0,
          "maxLength": 400
        },
        "templateType": {
          "type": "string",
          "enum": ["pickup_feedback", "cleanup_volunteer", "b2b_bulk_intake", "custom"]
        },
        "responseCount": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerUid",
        "title",
        "responderUri",
        "webViewLink",
        "templateType",
        "responseCount",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPublicProfile" },
      "description": "Non-PII citizen/operator profile summary."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Owner/admin-only private PII profile subcollection."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Trusted admin role membership registry."
    },
    "/scrap_rates/{itemId}": {
      "schema": { "$ref": "#/entities/ScrapRateRecord" },
      "description": "Live recyclable scrap spot pricing catalog."
    },
    "/pickup_orders/{orderId}": {
      "schema": { "$ref": "#/entities/PickupOrderRecord" },
      "description": "Doorstep pickup orders persisted per user."
    },
    "/activity_logs/{logId}": {
      "schema": { "$ref": "#/entities/ActivityLogRecord" },
      "description": "AI photo scans, AR spatial measurements, recycling tips, and workspace logs."
    },
    "/form_records/{formId}": {
      "schema": { "$ref": "#/entities/GoogleFormRecord" },
      "description": "Google Forms linked to PunarChakra feedback, cleanup drives, and bulk intake."
    }
  }
}
